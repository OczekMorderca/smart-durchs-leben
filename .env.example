# Skopiuj ten plik jako .env i uzupełnij wartości

# Azure App Registration Client ID (do synchronizacji z OneDrive)
# Instrukcja: https://portal.azure.com -> App registrations -> New registration
# Redirect URI: typ "Single-page application", URL: http://localhost:5173
VITE_ONEDRIVE_CLIENT_ID=twoj-client-id-tutaj
